[Unit]
Description=FirstIslamicCoin Electrum server (firstislamiccoin-electrumx)
After=network.target firstislamiccoind.service
Wants=firstislamiccoind.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
EnvironmentFile=/etc/firstislamiccoin-electrumx.conf
WorkingDirectory=__BUILD_DIR__
ExecStart=__BUILD_DIR__/venv/bin/python3 __BUILD_DIR__/electrumx_server
Restart=on-failure
RestartSec=10
LimitNOFILE=100000

# Hardening (electrumx needs no special privileges beyond its own data dir
# and outbound network to the daemon RPC + inbound on its service ports)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/firstislamiccoin-electrumx

[Install]
WantedBy=multi-user.target
