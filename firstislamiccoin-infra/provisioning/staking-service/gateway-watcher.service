[Unit]
Description=FirstIslamicCoin staking pool watcher pass (one-shot, run by gateway-watcher.timer)
After=network.target firstislamiccoind.service

[Service]
Type=oneshot
User=__USER__
Group=__GROUP__
EnvironmentFile=/etc/fic-gateway.conf
WorkingDirectory=__BUILD_DIR__
ExecStart=__BUILD_DIR__/venv/bin/python3 __BUILD_DIR__/watcher.py

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fic-gateway
