[Unit]
Description=FirstIslamicCoin mobile/web gateway (firstislamiccoin-staking-service)
After=network.target firstislamiccoind.service
Wants=firstislamiccoind.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
EnvironmentFile=/etc/fic-gateway.conf
WorkingDirectory=__BUILD_DIR__
# gunicorn, not the Flask dev server -- app.py's own __main__ block is
# explicitly for local testing only (see its module docstring and the
# "development server" warning Flask prints on startup).
ExecStart=__BUILD_DIR__/venv/bin/gunicorn --workers 4 --bind 0.0.0.0:8080 --access-logfile - app:app
Restart=on-failure
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fic-gateway

[Install]
WantedBy=multi-user.target
